{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cassandra values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "tls": { "$ref": "#/$defs/tls" },
    "cassandra": { "$ref": "#/$defs/cassandra" }
  },
  "$defs": {
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "optional": { "type": "boolean", "default": false },
        "keystorePass": { "type": "string", "default": "cassandra" }
      }
    },
    "cassandra": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "boolean", "default": true },
        "auditLogEnabled": { "type": "boolean", "default": false },
        "commitlogArchiving": { "$ref": "#/$defs/commitlogArchiving" },
        "configuration": { "type": "string" },
        "jvm_options": { "type": "string" },
        "cassandra_env": { "type": "string" }
      }
    },
    "commitlogArchiving": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "archive_command": { "type": "string" },
        "restore_command": { "type": "string" },
        "restore_directories": { "type": "string" }
      }
    }
  }
}
